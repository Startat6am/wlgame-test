# Local development: leave unset to connect to ws://localhost:2567.
# Vercel Preview/Production: after configuring Upstash Redis secrets, set this to /api/ws.
VITE_WS_SERVER_URL=

# Server-only secrets for the Vercel Function. Never prefix these with VITE_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
WLGAME_ROOM_ID=default
